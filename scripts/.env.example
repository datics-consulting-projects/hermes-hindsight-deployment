# Deploy target for the scripts in this directory.
#
#   cp scripts/.env.example scripts/.env
#
# Gitignored: the root .gitignore's ".env" pattern matches at any depth, which
# is the same mechanism that covers agents/<name>/.env. Nothing secret belongs
# in here — it is an address, not a credential — but it is machine-specific,
# so it stays out of git like every other .env in this repo.

# How to reach the VPS. Prefer an ssh_config alias or a Tailscale name over a
# public IP; these scripts run "git pull" and "docker compose" over this
# connection and nothing else.
HERMES_SSH=user@hermes-vps

# Where this repo is checked out on the VPS (README setup step 1).
HERMES_DIR=/opt/hermes-stack
