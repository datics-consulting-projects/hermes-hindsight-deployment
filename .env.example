# Copy this to .env and fill in real values. Never commit .env.

# --- Tailscale ---
# The VPS's own Tailscale IP, e.g. output of `tailscale ip -4` on the VPS.
# Ports are bound to this address only, never to the public interface.
# Required: the stack refuses to start without it, so that a missing value
# can never silently fall back to binding the public interface.
TAILSCALE_IP=100.x.y.z

# --- Hermes dashboard backend (used by Hermes Desktop's Remote Gateway) ---
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=change-me
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_SECRET=change-me

# --- Hermes chat model (the agent's own LLM) ---
# The API KEY goes here. The MODEL NAME does not — Hermes has no env var for
# it; it lives in config.yaml inside the hermes_data volume. Set it once with:
#
#   docker exec -it hermes hermes config set model openrouter/anthropic/claude-sonnet-4
#
# See "Choosing the Hermes chat model" in README.md.
#
# Leave this commented out if you configured the key through the setup wizard
# instead — an unset variable is passed through as "not set", so the wizard's
# value in the volume still wins. Using a different provider? Replace this with
# ANTHROPIC_API_KEY / OPENAI_API_KEY and update the matching line in
# docker-compose.yml.
OPENROUTER_API_KEY=sk-or-...

# --- Hindsight (memory extraction / synthesis LLM) ---
# This is a SEPARATE, much higher-volume call path than your chat turns above,
# and it can use a different provider and key. Valid providers include:
# openai, anthropic, gemini, groq, openrouter, deepseek, minimax, nous, xai-oauth,
# fireworks, vertexai, bedrock, litellm, ollama, lmstudio, llamacpp, none
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_API_KEY=sk-...
# Optional model override; leave unset to use the provider's default. Unlike
# the two above, this name is passed through verbatim, so it must keep the
# HINDSIGHT_API_ prefix the server expects.
# Example for openrouter: anthropic/claude-sonnet-4
#HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_VERSION=latest

# --- Hindsight's PostgreSQL backend ---
HINDSIGHT_DB_USER=hindsight_user
# Generate with: openssl rand -hex 24
HINDSIGHT_DB_PASSWORD=change-me
HINDSIGHT_DB_NAME=hindsight_db
HINDSIGHT_DB_VERSION=18

# --- Notion Integration ---
# IMPORTANT: Agents need their own token key to fine-grain control access rights.
#            Move to agents/<agent-type>/.env.example
NOTION_API_KEY=ntn_...
